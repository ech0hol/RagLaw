# DashScope (LLM + embedding)
DASHSCOPE_API_KEY=

# RagLaw dev
RAGLAW_LLM_MOCK=true
RAGLAW_SEED_ADMIN_PASSWORD=raglaw-eval

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=raglaw
MYSQL_USER=raglaw
MYSQL_PASSWORD=raglaw

# PostgreSQL (pgvector) — set POSTGRES_ENABLED=true for hybrid retrieval
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=raglaw_vector
POSTGRES_USER=raglaw
POSTGRES_PASSWORD=raglaw

# Embedding — set EMBEDDING_ENABLED=true; with RAGLAW_LLM_MOCK=true uses deterministic mock vectors (no API key)
EMBEDDING_ENABLED=false

# MinIO (optional object storage; default uses local ./tmp/raglaw-uploads)
MINIO_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=raglaw
MINIO_SECRET_KEY=raglawsecret
MINIO_BUCKET=raglaw

# RabbitMQ
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=raglaw
RABBITMQ_PASSWORD=raglaw

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Langfuse (profile observability)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
