# DashScope (LLM + embedding)
DASHSCOPE_API_KEY=

# RagLaw dev — set DASHSCOPE_API_KEY for real LLM; without key set RAGLAW_LLM_MOCK=true
RAGLAW_LLM_MOCK=false
# Test profile: mock rag_search to avoid H2 FULLTEXT limitations in AG-UI integration tests
RAGLAW_AGENTSCOPE_RAG_MOCK=false

# Tavily MCP (optional web search — enable per agent in Admin)
RAGLAW_MCP_ENABLED=false
TAVILY_API_KEY=
RAGLAW_SEED_ADMIN_PASSWORD=admin12345

# Dev login autofill (Vite dev server only; not used in production builds)
VITE_DEV_ADMIN_EMAIL=admin@raglaw.local
VITE_DEV_ADMIN_PASSWORD=admin12345

# JWT — required in production (raglaw.jwt.secret); must be >= 32 UTF-8 bytes, not a placeholder
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7

# CORS — comma-separated origins for production frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=raglaw
MYSQL_USER=raglaw
MYSQL_PASSWORD=raglaw

# Elasticsearch — hybrid retrieval (fulltext BM25 + vector kNN RRF fusion)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URI=http://localhost:9200

# Embedding — semantic search; requires ELASTICSEARCH_ENABLED=true and DASHSCOPE_API_KEY (or RAGLAW_LLM_MOCK=true)
EMBEDDING_ENABLED=true

# MinIO (object storage for uploaded originals; false falls back to local ./tmp/raglaw-uploads)
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=raglaw
MINIO_SECRET_KEY=raglawsecret
MINIO_BUCKET=raglaw

# RabbitMQ — async parse (raglaw.parse) + index (raglaw.index) pipeline
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=raglaw
RABBITMQ_PASSWORD=raglaw

# Index outbox — MySQL→Elasticsearch eventual consistency (enabled by default when ES is on)
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_FAILED_RETRY_DELAY_MS=60000

# Langfuse (profile observability)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
